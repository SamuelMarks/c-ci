# editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown
[*.md]
trim_trailing_whitespace = false

# Web & Config Data
[*.{json,yml,yaml,xml,html,css,js,ts,jsm,mjs,cjs}]
indent_size = 2

# CMake
[{CMakeLists.txt,*.cmake}]
indent_size = 2

# Windows Scripts
[*.{bat,cmd,ps1,psm1,psd1}]
end_of_line = crlf
indent_size = 2

# Shell Scripts
[*.{sh,bash,zsh,command}]
end_of_line = lf
indent_size = 2

# C/C++ Code
[*.{c,h,cpp,hpp,cxx,hxx,cc}]
indent_size = 4
indent_style = space

# Makefile
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4
