# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows Specific Scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Unix/macOS Specific Scripts
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.command text eol=lf

# Docker
*Dockerfile* text eol=lf
*.dockerignore text eol=lf

# Build Systems & Configs
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.xml text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Source Code
*.c text eol=lf diff=cpp
*.h text eol=lf diff=cpp
*.cpp text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp
*.cxx text eol=lf diff=cpp
*.hxx text eol=lf diff=cpp
*.cc text eol=lf diff=cpp

# Documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE* text eol=lf
